# Required: replace with a long, random webhook secret configured in GitHub.
WEBHOOK_SECRET=replace-with-a-long-random-development-secret

# Optional: defaults to 50 when omitted.
MAX_EVENTS=50

# Optional: defaults to 26214400 bytes, matching a 25 MiB webhook body ceiling.
MAX_WEBHOOK_BODY_BYTES=26214400

# Optional: defaults to memory. Use postgresql only after applying migrations.
DELIVERY_STORE_BACKEND=memory

# Optional: defaults to 5 seconds. Used only when DELIVERY_STORE_BACKEND=postgresql.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Optional for memory. Required when DELIVERY_STORE_BACKEND=postgresql.
DATABASE_URL=postgresql+psycopg://example_user:example_password@example-host:5432/example_database

# Optional: defaults to false. When false, management endpoints such as /events return 404.
MANAGEMENT_API_ENABLED=false

# Required only when MANAGEMENT_API_ENABLED=true. Use a high-entropy operator token in production.
# MANAGEMENT_API_TOKEN=replace-with-a-high-entropy-management-token-000001

# Optional: defaults to false. Requires MANAGEMENT_API_ENABLED=true when enabled.
GITHUB_RECONCILIATION_ENABLED=false

# Required only when GITHUB_RECONCILIATION_ENABLED=true.
# Token needs repository Webhooks: read permission only.
# GITHUB_REPOSITORY_WEBHOOK_TOKEN=replace-with-a-read-only-repository-webhook-token

# Optional: defaults to 5 seconds.
GITHUB_API_TIMEOUT_SECONDS=5

# Optional: defaults to 5. Allowed range is 1..20.
GITHUB_RECONCILIATION_MAX_PAGES=5
